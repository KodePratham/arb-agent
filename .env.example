# ══════════════════════════════════════════════════════════════════
#  arb-agent  —  Environment Configuration
# ══════════════════════════════════════════════════════════════════

# ── LLM (Ollama only) ────────────────────────────────────────────
LLM_PROVIDER=ollama
MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# ── BNB Mainnet RPCs ─────────────────────────────────────────────
BNB_RPC_URL=https://bsc-dataseed1.binance.org
BNB_RPC_URL_FALLBACK=https://bsc-dataseed2.binance.org
BNB_CHAIN_ID=56

# ── opBNB L2 (trade execution) ────────────────────────────────────
OPBNB_RPC_URL=https://opbnb-mainnet-rpc.bnbchain.org
OPBNB_CHAIN_ID=204
ARB_EXECUTOR_CONTRACT=0xYOUR_DEPLOYED_ARB_EXECUTOR_ADDRESS

# ── Wallet ────────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# ── Predict.fun ──────────────────────────────────────────────────
PREDICTFUN_API_BASE=https://api.predict.fun
PREDICTFUN_API_KEY=your_predict_fun_api_key_here
PREDICTFUN_WS_URL=wss://ws.predict.fun

# ── Probable (zero-fee, PancakeSwap-incubated, UMA oracle) ───────
# Public read API — no API key required for fetching markets/odds.
PROBABLE_API_BASE=https://probable.markets
PROBABLE_API_KEY=
PROBABLE_WS_URL=wss://probable.markets/ws

# ── ZeroMQ IPC (Engine SUB binds here; Python PUBs connect) ─────
ZMQ_ENGINE_ADDR=tcp://0.0.0.0:5555

# ── Trading Parameters ───────────────────────────────────────────
MIN_ARB_DELTA_BPS=50
MAX_TRADE_SIZE_USDT=500
GAS_PRICE_MULTIPLIER=1.1
SLIPPAGE_TOLERANCE_BPS=30
